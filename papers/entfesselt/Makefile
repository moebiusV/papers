# papers/entfesselt/Makefile — build config
# HTML and MD files are served as-is. No PDF or DOCX output.
SLUG := entfesselt
ROOT ?= $(abspath ../..)

.PHONY: build pdf docx clean readme

build: pdf docx

pdf:
	@echo "  SKIP $(SLUG) — HTML/MD only, no PDF"

docx:
	@echo "  SKIP $(SLUG) — HTML/MD only, no DOCX"

readme:
	@echo "  SKIP $(SLUG) — README not yet auto-generated"

clean:
	@:
